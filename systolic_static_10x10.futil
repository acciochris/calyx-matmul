static<5> component pe<"pos"={0}>(ain: 32, bin: 32, clear: 1) -> (aout: 32, bout: 32, out: 32) {
  cells {
    @pos{1} mult_pipe = std_mult_pipe(32);
    @pos{2} add = std_add(32);
    @pos{3} a = std_reg(32);
    @pos{4} b = std_reg(32);
    @pos{5} result = std_reg(32);
  }
  wires {
    out = result.out;
    aout = a.out;
    bout = b.out;
    static<1> group store_a<"pos"={6}> {
      a.in = !clear ? ain;
      a.in = clear ? 32'd0;
      a.write_en = 1'd1;
    }
    static<1> group store_b<"pos"={6}> {
      b.in = !clear ? bin;
      b.in = clear ? 32'd0;
      b.write_en = 1'd1;
    }
    static<4> group mult_and_add<"pos"={7}> {
      mult_pipe.left = %[0:3] ? a.out;
      mult_pipe.right = %[0:3] ? b.out;
      mult_pipe.go = %[0:3] ? 1'd1;
      add.left = result.out;
      add.right = mult_pipe.out;
      result.in = (!clear & %3) ? add.out;
      result.in = clear ? 32'd0;
      result.write_en = %3 ? 1'd1;
    }
  }
  control {
    @pos{9} static seq {
      @pos{8} static par {
        @pos{8} store_a;
        @pos{8} store_b;
      }
      @pos{9} mult_and_add;
    }
  }
}
