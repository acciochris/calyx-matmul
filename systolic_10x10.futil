import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories/comb.futil";
component pe<"pos"={0}>(ain: 32, bin: 32, clear: 1) -> (aout: 32, bout: 32, out: 32) {
  cells {
    @pos{1} mult_pipe = std_mult_pipe(32);
    @pos{2} add = std_add(32);
    @pos{3} a = std_reg(32);
    @pos{4} b = std_reg(32);
    @pos{5} result = std_reg(32);
  }
  wires {
    out = result.out;
    aout = a.out;
    bout = b.out;
    group store_a<"pos"={6}> {
      a.in = !clear ? ain;
      a.in = clear ? 32'd0;
      a.write_en = 1'd1;
      store_a[done] = a.done;
    }
    group store_b<"pos"={7}> {
      b.in = !clear ? bin;
      b.in = clear ? 32'd0;
      b.write_en = 1'd1;
      store_b[done] = b.done;
    }
    group mult_and_add<"pos"={8}> {
      mult_pipe.left = a.out;
      mult_pipe.right = b.out;
      mult_pipe.go = 1'd1;
      add.left = result.out;
      add.right = mult_pipe.out;
      result.in = (!clear & mult_pipe.done) ? add.out;
      result.in = clear ? 32'd0;
      result.write_en = mult_pipe.done;
      mult_and_add[done] = result.done;
    }
  }
  control {
    @pos{10} seq {
      @pos{9} par {
        @pos{9} store_a;
        @pos{9} store_b;
      }
      @pos{10} mult_and_add;
    }
  }
}
